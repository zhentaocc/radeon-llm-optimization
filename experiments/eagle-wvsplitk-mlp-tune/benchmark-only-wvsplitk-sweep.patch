diff --git a/csrc/rocm/skinny_gemms.cu b/csrc/rocm/skinny_gemms.cu
index 615cdab..a4f5f7e 100644
--- a/csrc/rocm/skinny_gemms.cu
+++ b/csrc/rocm/skinny_gemms.cu
@@ -1180,0 +1181,14 @@ int mindiv(int N, int div1, int div2) {
+// A bounded form of mindiv for benchmark configurations with fewer than 16
+// waves per group. It selects the smallest active wave count that does not
+// increase the number of output-row rounds.
+int mindiv_bounded(int N, int div1, int max_div2) {
+  const int base_rounds = (N + div1 * max_div2 - 1) / (div1 * max_div2);
+  int active = max_div2;
+  for (int waves = max_div2 - 1; waves >= 1; --waves) {
+    const int rounds = (N + div1 * waves - 1) / (div1 * waves);
+    if (rounds != base_rounds) break;
+    active = waves;
+  }
+  return active;
+}
