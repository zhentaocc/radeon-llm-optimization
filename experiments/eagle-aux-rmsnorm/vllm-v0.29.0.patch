+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm import _custom_ops as ops
+from vllm.model_executor.layers.eagle_aux_rmsnorm import fused_two_aux_rms_norm
+from vllm.model_executor.models.qwen3_eagle3 import Eagle3Qwen3ForCausalLM
+
+
+class _ReferenceRMSNorm:
+    def __init__(self, weight: torch.Tensor, eps: float) -> None:
+        self.weight = weight
+        self.variance_epsilon = eps
+
+    def __call__(self, x: torch.Tensor) -> torch.Tensor:
+        out = torch.empty_like(x)
+        ops.rms_norm(out, x, self.weight, self.variance_epsilon)
+        return out
+
+
+@pytest.mark.parametrize("num_tokens", [1, 3, 16, 64])
+@pytest.mark.parametrize("hidden_size", [256, 5120])
+@torch.inference_mode()
+def test_fused_two_aux_rms_norm(num_tokens: int, hidden_size: int) -> None:
+    torch.manual_seed(0)
+    device = "cuda"
+    dtype = torch.bfloat16
+    eps = 1e-6
+    x0 = torch.randn(num_tokens, hidden_size, device=device, dtype=dtype)
+    x1 = torch.randn(num_tokens, hidden_size, device=device, dtype=dtype)
+    weight0 = torch.randn(hidden_size, device=device, dtype=dtype)
+    weight1 = torch.randn(hidden_size, device=device, dtype=dtype)
+
+    expected0 = torch.empty_like(x0)
+    expected1 = torch.empty_like(x1)
+    ops.rms_norm(expected0, x0, weight0, eps)
+    ops.rms_norm(expected1, x1, weight1, eps)
+    expected = torch.cat((expected0, expected1), dim=-1)
+
+    actual = fused_two_aux_rms_norm(x0, x1, weight0, weight1, eps)
+
+    torch.testing.assert_close(actual, expected, atol=2e-2, rtol=2e-2)
+
+
+@torch.inference_mode()
+def test_qwen3_eagle3_combines_two_aux_states_with_fused_norm() -> None:
+    torch.manual_seed(0)
+    num_tokens = 4
+    hidden_size = 5120
+    eps = 1e-6
+    x0 = torch.randn(
+        num_tokens, hidden_size, device="cuda", dtype=torch.bfloat16
+    )
+    x1 = torch.randn_like(x0)
+    weight0 = torch.randn(hidden_size, device="cuda", dtype=torch.bfloat16)
+    weight1 = torch.randn_like(weight0)
+
+    expected0 = torch.empty_like(x0)
+    expected1 = torch.empty_like(x1)
+    ops.rms_norm(expected0, x0, weight0, eps)
+    ops.rms_norm(expected1, x1, weight1, eps)
+    expected = torch.cat((expected0, expected1), dim=-1)
+
+    model = SimpleNamespace(
+        use_aux_hidden_state=True,
+        norm_before_fc=False,
+        fc_norm=[
+            SimpleNamespace(weight=weight0, variance_epsilon=eps),
+            SimpleNamespace(weight=weight1, variance_epsilon=eps),
+        ],
+        fc=lambda x: x,
+    )
+    eagle = SimpleNamespace(model=model)
+    actual = Eagle3Qwen3ForCausalLM.combine_hidden_states(eagle, [x0, x1])
+
+    torch.testing.assert_close(actual, expected, atol=2e-2, rtol=2e-2)
+
+
+@torch.inference_mode()
+def test_fused_two_aux_rms_norm_cuda_graph() -> None:
+    torch.manual_seed(0)
+    num_tokens = 16
+    hidden_size = 5120
+    eps = 1e-6
+    x0 = torch.randn(
+        num_tokens, hidden_size, device="cuda", dtype=torch.bfloat16
+    )
+    x1 = torch.randn_like(x0)
+    weight0 = torch.randn(hidden_size, device="cuda", dtype=torch.bfloat16)
+    weight1 = torch.randn_like(weight0)
+
+    expected = fused_two_aux_rms_norm(x0, x1, weight0, weight1, eps)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        actual = fused_two_aux_rms_norm(x0, x1, weight0, weight1, eps)
+
+    x0.normal_()
+    x1.normal_()
+    expected = fused_two_aux_rms_norm(x0, x1, weight0, weight1, eps)
+    graph.replay()
+    torch.testing.assert_close(actual, expected, atol=2e-2, rtol=2e-2)
+
+
+@torch.inference_mode()
+def test_qwen3_eagle3_falls_back_for_different_aux_epsilons() -> None:
+    torch.manual_seed(0)
+    x0 = torch.randn(4, 256, device="cuda", dtype=torch.bfloat16)
+    x1 = torch.randn_like(x0)
+    norm0 = _ReferenceRMSNorm(
+        torch.randn(256, device="cuda", dtype=torch.bfloat16), 1e-5
+    )
+    norm1 = _ReferenceRMSNorm(
+        torch.randn(256, device="cuda", dtype=torch.bfloat16), 1e-6
+    )
+    expected = torch.cat((norm0(x0), norm1(x1)), dim=-1)
+
+    model = SimpleNamespace(
+        use_aux_hidden_state=True,
+        norm_before_fc=False,
+        fc_norm=[norm0, norm1],
+        num_aux_layers=2,
+        fc=lambda x: x,
+    )
+    eagle = SimpleNamespace(model=model)
+    actual = Eagle3Qwen3ForCausalLM.combine_hidden_states(eagle, [x0, x1])
+
+    torch.testing.assert_close(actual, expected)
diff --git a/vllm/model_executor/layers/eagle_aux_rmsnorm.py b/vllm/model_executor/layers/eagle_aux_rmsnorm.py
new file mode 100644
index 0000000..e34448f
--- /dev/null
+++ b/vllm/model_executor/layers/eagle_aux_rmsnorm.py
@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from __future__ import annotations
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _fused_two_aux_rms_norm_kernel(
+    x0_ptr,
+    x1_ptr,
+    weight0_ptr,
+    weight1_ptr,
+    output_ptr,
+    stride_x0_row,
+    stride_x1_row,
+    stride_output_row,
+    hidden_size: tl.constexpr,
+    eps: tl.constexpr,
+    block_size: tl.constexpr,
+):
+    row = tl.program_id(0)
+    aux = tl.program_id(1)
+    offsets = tl.arange(0, block_size)
+    mask = offsets < hidden_size
+
+    if aux == 0:
+        values = tl.load(
+            x0_ptr + row * stride_x0_row + offsets,
+            mask=mask,
+            other=0.0,
+        ).to(tl.float32)
+        weights = tl.load(weight0_ptr + offsets, mask=mask, other=0.0).to(
+            tl.float32
+        )
+    else:
+        values = tl.load(
+            x1_ptr + row * stride_x1_row + offsets,
+            mask=mask,
+            other=0.0,
+        ).to(tl.float32)
+        weights = tl.load(weight1_ptr + offsets, mask=mask, other=0.0).to(
+            tl.float32
+        )
+
+    variance = tl.sum(values * values, axis=0) / hidden_size
+    normalized = values * tl.rsqrt(variance + eps) * weights
+    output_offsets = row * stride_output_row + aux * hidden_size + offsets
+    tl.store(output_ptr + output_offsets, normalized, mask=mask)
+
+
+def fused_two_aux_rms_norm(
+    x0: torch.Tensor,
+    x1: torch.Tensor,
+    weight0: torch.Tensor,
+    weight1: torch.Tensor,
+    eps: float,
+) -> torch.Tensor:
+    """RMS-normalize two EAGLE aux tensors into one concatenated output."""
+    if x0.ndim != 2 or x1.ndim != 2 or x0.shape != x1.shape:
+        raise ValueError("EAGLE aux tensors must be rank-2 and have equal shapes")
+    if x0.stride(1) != 1 or x1.stride(1) != 1:
+        raise ValueError(
+            "EAGLE aux tensors must be contiguous in the hidden dimension"
+        )
+    if weight0.shape != (x0.shape[1],) or weight1.shape != (x0.shape[1],):
+        raise ValueError("EAGLE aux RMSNorm weights must match the hidden size")
+    if x0.dtype != x1.dtype or x0.device != x1.device:
+        raise ValueError("EAGLE aux tensors must have the same dtype and device")
+    if weight0.device != x0.device or weight1.device != x0.device:
+        raise ValueError("EAGLE aux RMSNorm weights must be on the input device")
+    if weight0.dtype != x0.dtype or weight1.dtype != x0.dtype:
+        raise ValueError("EAGLE aux RMSNorm weights must match the input dtype")
+    if not weight0.is_contiguous() or not weight1.is_contiguous():
+        raise ValueError("EAGLE aux RMSNorm weights must be contiguous")
+
+    num_tokens, hidden_size = x0.shape
+    output = torch.empty(
+        num_tokens,
+        2 * hidden_size,
+        dtype=x0.dtype,
+        device=x0.device,
+    )
+    if num_tokens == 0:
+        return output
+
+    block_size = triton.next_power_of_2(hidden_size)
+    num_warps = 8 if block_size >= 4096 else 4
+    _fused_two_aux_rms_norm_kernel[(num_tokens, 2)](
+        x0,
+        x1,
+        weight0,
+        weight1,
+        output,
+        x0.stride(0),
+        x1.stride(0),
+        output.stride(0),
+        hidden_size=hidden_size,
+        eps=eps,
+        block_size=block_size,
+        num_warps=num_warps,
+    )
+    return output
diff --git a/vllm/model_executor/models/qwen3_eagle3.py b/vllm/model_executor/models/qwen3_eagle3.py
index 5b4e5a7..e1f8457 100644
--- a/vllm/model_executor/models/qwen3_eagle3.py
+++ b/vllm/model_executor/models/qwen3_eagle3.py
@@ -368,12 +368,39 @@ class Eagle3Qwen3ForCausalLM(Qwen3ForCausalLM):
 
     def combine_hidden_states(
         self,
-        hidden_states: torch.Tensor,
+        hidden_states: torch.Tensor | list[torch.Tensor],
     ) -> torch.Tensor:
         if not self.model.use_aux_hidden_state:
+            assert isinstance(hidden_states, torch.Tensor)
             return hidden_states
         # combine multiple auxiliary hidden states returned by eagle3
 
+        if isinstance(hidden_states, list):
+            if (
+                not self.model.norm_before_fc
+                and self.model.fc_norm is not None
+                and len(hidden_states) == 2
+                and hidden_states[0].is_cuda
+                and hidden_states[0].dtype == hidden_states[1].dtype
+                and hidden_states[0].dtype == self.model.fc_norm[0].weight.dtype
+                and hidden_states[0].dtype == self.model.fc_norm[1].weight.dtype
+                and self.model.fc_norm[0].variance_epsilon
+                == self.model.fc_norm[1].variance_epsilon
+            ):
+                from vllm.model_executor.layers.eagle_aux_rmsnorm import (
+                    fused_two_aux_rms_norm,
+                )
+
+                hidden_states = fused_two_aux_rms_norm(
+                    hidden_states[0],
+                    hidden_states[1],
+                    self.model.fc_norm[0].weight,
+                    self.model.fc_norm[1].weight,
+                    self.model.fc_norm[0].variance_epsilon,
+                )
+                return self.model.fc(hidden_states)
+            hidden_states = torch.cat(hidden_states, dim=-1)
+
         if self.model.norm_before_fc:
             hidden_states = self.model.input_norm(hidden_states)
 
