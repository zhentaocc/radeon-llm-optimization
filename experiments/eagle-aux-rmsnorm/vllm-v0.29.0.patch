@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import json
+from collections.abc import Callable
+from pathlib import Path
+
+import torch
+from torch.profiler import ProfilerActivity, profile, record_function
+
+from benchmark_eagle_aux_rmsnorm import baseline
+from vllm.model_executor.layers.eagle_aux_rmsnorm import fused_two_aux_rms_norm
+
+
+def profile_kernels(
+    label: str,
+    fn: Callable[[], torch.Tensor],
+    trace_path: Path,
+) -> list[str]:
+    fn()
+    torch.cuda.synchronize()
+    with profile(
+        activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA],
+    ) as prof:
+        with record_function(label):
+            fn()
+        torch.cuda.synchronize()
+    prof.export_chrome_trace(str(trace_path))
+    trace = json.loads(trace_path.read_text())
+    return [
+        event["name"]
+        for event in trace["traceEvents"]
+        if event.get("cat", "").lower() == "kernel"
+    ]
+
+
+def main() -> None:
+    num_tokens = 16
+    hidden_size = 5120
+    eps = 1e-6
+    x0 = torch.randn(
+        num_tokens, hidden_size, device="cuda", dtype=torch.bfloat16
+    )
+    x1 = torch.randn_like(x0)
+    weight0 = torch.randn(hidden_size, device="cuda", dtype=torch.bfloat16)
+    weight1 = torch.randn_like(weight0)
+
+    baseline_names = profile_kernels(
+        "baseline_aux_prep",
+        lambda: baseline(x0, x1, weight0, weight1, eps),
+        Path("/tmp/eagle_aux_baseline_trace.json"),
+    )
+    fused_names = profile_kernels(
+        "fused_aux_prep",
+        lambda: fused_two_aux_rms_norm(x0, x1, weight0, weight1, eps),
+        Path("/tmp/eagle_aux_fused_trace.json"),
+    )
+    print(json.dumps({"baseline": baseline_names, "fused": fused_names}, indent=2))
+    print(f"kernel_launches,{len(baseline_names)},{len(fused_names)}")
+
+
+if __name__ == "__main__":
+    main()
