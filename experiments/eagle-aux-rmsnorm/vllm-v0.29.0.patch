index 0000000..96da859
--- /dev/null
+++ b/benchmarks/kernels/benchmark_eagle_aux_rmsnorm.py
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import argparse
+
+import torch
+
+from vllm import _custom_ops as ops
+from vllm.model_executor.layers.eagle_aux_rmsnorm import fused_two_aux_rms_norm
+from vllm.triton_utils import triton
+
+
+def baseline(
+    x0: torch.Tensor,
+    x1: torch.Tensor,
+    weight0: torch.Tensor,
+    weight1: torch.Tensor,
+    eps: float,
+) -> torch.Tensor:
+    hidden_states = torch.cat((x0, x1), dim=-1)
+    chunk0, chunk1 = hidden_states.chunk(2, dim=-1)
+    out0 = torch.empty_like(chunk0)
+    out1 = torch.empty_like(chunk1)
+    ops.rms_norm(out0, chunk0, weight0, eps)
+    ops.rms_norm(out1, chunk1, weight1, eps)
+    return torch.cat((out0, out1), dim=-1)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--hidden-size", type=int, default=5120)
+    parser.add_argument(
+        "--tokens", type=int, nargs="+", default=[1, 2, 4, 8, 16, 32, 64]
+    )
+    args = parser.parse_args()
+
+    eps = 1e-6
+    print("tokens,baseline_us,fused_us,speedup")
+    for num_tokens in args.tokens:
+        x0 = torch.randn(
+            num_tokens, args.hidden_size, device="cuda", dtype=torch.bfloat16
+        )
+        x1 = torch.randn_like(x0)
+        weight0 = torch.randn(args.hidden_size, device="cuda", dtype=torch.bfloat16)
+        weight1 = torch.randn_like(weight0)
+
+        expected = baseline(x0, x1, weight0, weight1, eps)
+        actual = fused_two_aux_rms_norm(x0, x1, weight0, weight1, eps)
+        torch.testing.assert_close(actual, expected, atol=2e-2, rtol=2e-2)
+
+        baseline_ms = triton.testing.do_bench(
+            lambda: baseline(x0, x1, weight0, weight1, eps),
+            warmup=100,
+            rep=500,
+        )
+        fused_ms = triton.testing.do_bench(
+            lambda: fused_two_aux_rms_norm(x0, x1, weight0, weight1, eps),
+            warmup=100,
+            rep=500,
+        )
+        print(
+            f"{num_tokens},{baseline_ms * 1000:.3f},{fused_ms * 1000:.3f},"
+            f"{baseline_ms / fused_ms:.3f}"
+        )
+
+
+if __name__ == "__main__":
+    main()
