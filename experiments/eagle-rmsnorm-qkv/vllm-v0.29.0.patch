+std::tuple<torch::Tensor, torch::Tensor> wvSplitKRMSNorm(
+    const at::Tensor& weight, const at::Tensor& hidden,
+    const at::Tensor& residual, const at::Tensor& norm_weight,
+    const double epsilon, const int64_t CuCount) {
+  TORCH_CHECK(on_gfx1x(),
+              "wvSplitKRMSNorm is restricted to RDNA gfx11/gfx12");
+  TORCH_CHECK(weight.dim() == 2 && hidden.dim() == 2 && residual.dim() == 2,
+              "weight, hidden, and residual must be 2-D");
+  TORCH_CHECK(norm_weight.dim() == 1, "norm_weight must be 1-D");
+  TORCH_CHECK(weight.is_contiguous() && hidden.is_contiguous() &&
+                  residual.is_contiguous() && norm_weight.is_contiguous(),
+              "all operands must be contiguous");
+  TORCH_CHECK(weight.dtype() == hidden.dtype() &&
+                  hidden.dtype() == residual.dtype() &&
+                  residual.dtype() == norm_weight.dtype(),
+              "all operands must have the same dtype");
+  TORCH_CHECK(hidden.dtype() == torch::kFloat16 ||
+                  hidden.dtype() == torch::kBFloat16,
+              "only fp16 and bf16 are supported");
+  TORCH_CHECK(hidden.sizes() == residual.sizes(),
+              "hidden and residual shapes must match");
+  TORCH_CHECK(weight.size(1) == hidden.size(1) &&
+                  norm_weight.size(0) == hidden.size(1),
+              "K dimensions must match");
+  TORCH_CHECK(hidden.size(0) >= 1 && hidden.size(0) <= 5,
+              "token count must be in [1, 5]");
+  TORCH_CHECK(hidden.size(1) % 8 == 0, "K must be divisible by 8");
+  TORCH_CHECK(weight.size(0) > 8, "output width must be greater than 8");
+  TORCH_CHECK(epsilon > 0.0, "epsilon must be positive");
+  TORCH_CHECK(CuCount > 0, "CuCount must be positive");
+
+  const auto M_in = weight.size(0);
+  const auto K_in = weight.size(1);
+  const auto N_in = hidden.size(0);
+  const auto Kap_in = weight.stride(0);
+  const auto Kbp_in = hidden.stride(0);
+  const int64_t norm_state_bytes =
+      (N_in * 16 + N_in) * static_cast<int64_t>(sizeof(float));
+  const int64_t activation_bytes =
+      Kbp_in * N_in * static_cast<int64_t>(hidden.element_size());
+  TORCH_CHECK(activation_bytes + norm_state_bytes <= get_lds_size(),
+              "activation and RMSNorm reduction state must fit LDS");
+
+  auto out = torch::empty({N_in, M_in}, hidden.options());
+  auto residual_out = torch::empty_like(residual);
+  dim3 grid(CuCount);
+  const at::cuda::OptionalCUDAGuard device_guard(device_of(hidden));
+  const cudaStream_t stream = at::cuda::getCurrentCUDAStream();
+
+#define WVSPLITK_RMS_CFG(_YTILE, _UNRL, _N)                                \
+  {                                                                        \
+    dim3 block(32, 16);                                                    \
+    int __wvPrGrp = mindiv(M_in, CuCount * _YTILE, 16);                   \
+    wvSplitK_hf_sml_<fptype, 32, _YTILE, 16, 8, _UNRL, _N, true>          \
+        <<<grid, block, 0, stream>>>(                                      \
+            K_in, Kap_in, Kbp_in, M_in, 1, 1, weight_ptr, hidden_ptr,      \
+            residual_ptr, norm_weight_ptr, static_cast<float>(epsilon),    \
+            residual_out_ptr, nullptr, out_ptr, __wvPrGrp, CuCount);       \
+  }
+
+#define WVSPLITK_RMS_TILE(_sYT, _N)            \
+  {                                             \
+    if (_sYT <= 1)                              \
+      WVSPLITK_RMS_CFG(1, 4, _N)                \
+    else if ((_N == 1) || (_sYT <= 4 * 2))      \
+      WVSPLITK_RMS_CFG(2, 2, _N)                \
+    else if (_sYT <= 4 * 3)                     \
+      WVSPLITK_RMS_CFG(3, 2, _N)                \
+    else if (_N == 4)                           \
+      WVSPLITK_RMS_CFG(4, 1, _N)                \
+    else                                        \
+      WVSPLITK_RMS_CFG(4, 2, _N)                \
+  }
+
+  AT_DISPATCH_REDUCED_FLOATING_TYPES(hidden.scalar_type(),
+                                     "wvSplitKRMSNorm", [&] {
+    using fptype = typename scalar<scalar_t>::type;
+    const fptype* weight_ptr =
+        reinterpret_cast<const fptype*>(weight.data_ptr());
+    const fptype* hidden_ptr =
+        reinterpret_cast<const fptype*>(hidden.data_ptr());
+    const fptype* residual_ptr =
+        reinterpret_cast<const fptype*>(residual.data_ptr());
+    const fptype* norm_weight_ptr =
+        reinterpret_cast<const fptype*>(norm_weight.data_ptr());
+    fptype* residual_out_ptr =
+        reinterpret_cast<fptype*>(residual_out.data_ptr());
+    fptype* out_ptr = reinterpret_cast<fptype*>(out.data_ptr());
+    const int sYT = (M_in + CuCount * 4 - 1) / (CuCount * 4);
+
+    switch (N_in) {
+      case 1:
+        WVSPLITK_RMS_TILE(sYT, 1)
+        break;
+      case 2:
+        WVSPLITK_RMS_TILE(sYT, 2)
+        break;
+      case 3:
+        WVSPLITK_RMS_TILE(sYT, 3)
+        break;
+      case 4:
+        WVSPLITK_RMS_TILE(sYT, 4)
+        break;
+      case 5:
+        WVSPLITK_RMS_TILE(sYT, 5)
+        break;
+    }
+  });
+
+#undef WVSPLITK_RMS_TILE
+#undef WVSPLITK_RMS_CFG
+  return {out, residual_out};
+}
+
