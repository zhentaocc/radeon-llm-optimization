+def is_rocm_fused_rmsnorm_qkv_shape_supported(
+    hidden: torch.Tensor,
+    residual: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qkv_weight: torch.Tensor,
+    bias: torch.Tensor | None,
+) -> bool:
+    if bias is not None or hidden.dtype not in (torch.float16, torch.bfloat16):
+        return False
+    if not (
+        hidden.dtype == residual.dtype == norm_weight.dtype == qkv_weight.dtype
+    ):
+        return False
+    if hidden.ndim != 2 or residual.shape != hidden.shape:
+        return False
+    if norm_weight.ndim != 1 or qkv_weight.ndim != 2:
+        return False
+    num_tokens, hidden_size = hidden.shape
+    if not (1 <= num_tokens <= 5) or hidden_size % 8 != 0:
+        return False
+    if norm_weight.shape[0] != hidden_size or qkv_weight.shape[1] != hidden_size:
+        return False
+    if qkv_weight.shape[0] <= 8:
+        return False
+    operands = (hidden, residual, norm_weight, qkv_weight)
+    return all(x.is_contiguous() and x.device == hidden.device for x in operands)
+
+
+def can_use_rocm_fused_rmsnorm_qkv(
+    hidden: torch.Tensor,
+    residual: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qkv_weight: torch.Tensor,
+    bias: torch.Tensor | None,
+) -> bool:
+    """Return whether the experimental RDNA skinny fusion is safe.
+
+    Every rejected shape uses the existing RMSNorm and linear paths. The
+    kernel deliberately does not replace hipBLASLt for larger token batches.
+    """
+    if not envs.VLLM_ROCM_USE_FUSED_RMSNORM_QKV or not current_platform.is_rocm():
+        return False
+    from vllm.platforms.rocm import on_gfx1x
+
+    return (
+        on_gfx1x()
+        and envs.VLLM_ROCM_USE_SKINNY_GEMM
+        and is_rocm_fused_rmsnorm_qkv_shape_supported(
+            hidden, residual, norm_weight, qkv_weight, bias
+        )
+    )
+
+
+def rocm_fused_rmsnorm_qkv_impl(
+    hidden: torch.Tensor,
+    residual: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qkv_weight: torch.Tensor,
+    epsilon: float,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    return ops.wvSplitKRMSNorm(
+        qkv_weight,
+        hidden,
+        residual,
+        norm_weight,
+        epsilon,
+        num_compute_units(),
+    )
+
+
+def rocm_fused_rmsnorm_qkv_fake(
+    hidden: torch.Tensor,
+    residual: torch.Tensor,
+    norm_weight: torch.Tensor,
+    qkv_weight: torch.Tensor,
+    epsilon: float,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    del residual, norm_weight, epsilon
+    qkv = hidden.new_empty((*hidden.shape[:-1], qkv_weight.shape[0]))
+    residual_out = hidden.new_empty(hidden.shape)
+    return qkv, residual_out
+
+
