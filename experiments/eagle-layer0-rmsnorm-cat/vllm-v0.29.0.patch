+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import json
+from collections.abc import Callable
+from pathlib import Path
+
+import torch
+from torch.profiler import ProfilerActivity, profile, record_function
+
+from benchmark_eagle_layer0_rmsnorm import baseline
+from vllm.model_executor.layers.eagle_aux_rmsnorm import fused_two_aux_rms_norm
+
+
+def profile_kernels(
+    label: str,
+    fn: Callable[[], torch.Tensor],
+    trace_path: Path,
+) -> list[str]:
+    fn()
+    torch.cuda.synchronize()
+    with profile(
+        activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA],
+    ) as prof:
+        with record_function(label):
+            fn()
+        torch.cuda.synchronize()
+    prof.export_chrome_trace(str(trace_path))
+    trace = json.loads(trace_path.read_text())
+    return [
+        event["name"]
+        for event in trace["traceEvents"]
+        if event.get("cat", "").lower() == "kernel"
+    ]
+
+
+def main() -> None:
+    num_tokens = 16
+    hidden_size = 5120
+    eps = 1e-6
+    embeds = torch.randn(
+        num_tokens, hidden_size, device="cuda", dtype=torch.bfloat16
+    )
+    hidden_states = torch.randn_like(embeds)
+    embed_weight = torch.randn(hidden_size, device="cuda", dtype=torch.bfloat16)
+    hidden_weight = torch.randn_like(embed_weight)
+
+    baseline_names = profile_kernels(
+        "baseline_eagle_layer0_prep",
+        lambda: baseline(
+            embeds, hidden_states, embed_weight, hidden_weight, eps
+        ),
+        Path("/tmp/eagle_layer0_baseline_trace.json"),
+    )
+    fused_names = profile_kernels(
+        "fused_eagle_layer0_prep",
+        lambda: fused_two_aux_rms_norm(
+            embeds, hidden_states, embed_weight, hidden_weight, eps
+        ),
+        Path("/tmp/eagle_layer0_fused_trace.json"),
+    )
+    print(json.dumps({"baseline": baseline_names, "fused": fused_names}, indent=2))
+    print(f"kernel_launches,{len(baseline_names)},{len(fused_names)}")
+
+
+if __name__ == "__main__":
+    main()
