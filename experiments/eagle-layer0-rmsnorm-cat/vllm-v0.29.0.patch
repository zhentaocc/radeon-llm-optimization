+++ b/benchmarks/kernels/benchmark_eagle_layer0_rmsnorm.py
@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import argparse
+
+import torch
+
+from vllm import _custom_ops as ops
+from vllm.model_executor.layers.eagle_aux_rmsnorm import fused_two_aux_rms_norm
+from vllm.triton_utils import triton
+
+
+def baseline(
+    embeds: torch.Tensor,
+    hidden_states: torch.Tensor,
+    embed_weight: torch.Tensor,
+    hidden_weight: torch.Tensor,
+    eps: float,
+) -> torch.Tensor:
+    normed_embeds = torch.empty_like(embeds)
+    normed_hidden = torch.empty_like(hidden_states)
+    ops.rms_norm(normed_embeds, embeds, embed_weight, eps)
+    ops.rms_norm(normed_hidden, hidden_states, hidden_weight, eps)
+    return torch.cat((normed_embeds, normed_hidden), dim=-1)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--hidden-size", type=int, default=5120)
+    parser.add_argument(
+        "--tokens", type=int, nargs="+", default=[1, 2, 4, 8, 16, 32, 64]
+    )
+    args = parser.parse_args()
+
+    eps = 1e-6
+    print("tokens,baseline_us,fused_us,speedup")
+    for num_tokens in args.tokens:
+        embeds = torch.randn(
+            num_tokens, args.hidden_size, device="cuda", dtype=torch.bfloat16
+        )
+        hidden_states = torch.randn_like(embeds)
+        embed_weight = torch.randn(
+            args.hidden_size, device="cuda", dtype=torch.bfloat16
+        )
+        hidden_weight = torch.randn_like(embed_weight)
+
+        expected = baseline(
+            embeds, hidden_states, embed_weight, hidden_weight, eps
+        )
+        actual = fused_two_aux_rms_norm(
+            embeds, hidden_states, embed_weight, hidden_weight, eps
+        )
+        torch.testing.assert_close(actual, expected, atol=2e-2, rtol=2e-2)
+
+        baseline_ms = triton.testing.do_bench(
+            lambda: baseline(
+                embeds, hidden_states, embed_weight, hidden_weight, eps
+            ),
+            warmup=100,
+            rep=500,
+        )
+        fused_ms = triton.testing.do_bench(
+            lambda: fused_two_aux_rms_norm(
+                embeds, hidden_states, embed_weight, hidden_weight, eps
+            ),
+            warmup=100,
+            rep=500,
+        )
+        print(
+            f"{num_tokens},{baseline_ms * 1000:.3f},{fused_ms * 1000:.3f},"
+            f"{baseline_ms / fused_ms:.3f}"
+        )
+
+
+if __name__ == "__main__":
+    main()
