+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from __future__ import annotations
+
+import torch
+
+from vllm.platforms import current_platform
+from vllm.triton_utils import tl, triton
+from vllm.utils.torch_utils import direct_register_custom_op
+
+
+@triton.jit
+def _fused_two_aux_rms_norm_kernel(
+    x0_ptr,
+    x1_ptr,
+    weight0_ptr,
+    weight1_ptr,
+    output_ptr,
+    stride_x0_row,
+    stride_x1_row,
+    stride_output_row,
+    hidden_size: tl.constexpr,
+    eps: tl.constexpr,
+    block_size: tl.constexpr,
+):
+    row = tl.program_id(0)
+    aux = tl.program_id(1)
+    offsets = tl.arange(0, block_size)
+    mask = offsets < hidden_size
+
+    if aux == 0:
+        values = tl.load(
+            x0_ptr + row * stride_x0_row + offsets,
+            mask=mask,
+            other=0.0,
+        ).to(tl.float32)
+        weights = tl.load(weight0_ptr + offsets, mask=mask, other=0.0).to(
+            tl.float32
+        )
+    else:
+        values = tl.load(
+            x1_ptr + row * stride_x1_row + offsets,
+            mask=mask,
+            other=0.0,
+        ).to(tl.float32)
+        weights = tl.load(weight1_ptr + offsets, mask=mask, other=0.0).to(
+            tl.float32
+        )
+
+    variance = tl.sum(values * values, axis=0) / hidden_size
+    normalized = values * tl.rsqrt(variance + eps) * weights
+    output_offsets = row * stride_output_row + aux * hidden_size + offsets
+    tl.store(output_ptr + output_offsets, normalized, mask=mask)
+
+
+def _fused_two_aux_rms_norm_impl(
+    x0: torch.Tensor,
+    x1: torch.Tensor,
+    weight0: torch.Tensor,
+    weight1: torch.Tensor,
+    eps: float,
+) -> torch.Tensor:
+    num_tokens, hidden_size = x0.shape
+    output = torch.empty(
+        num_tokens,
+        2 * hidden_size,
+        dtype=x0.dtype,
+        device=x0.device,
+    )
+    if num_tokens == 0:
+        return output
+
+    block_size = triton.next_power_of_2(hidden_size)
+    num_warps = 8 if block_size >= 4096 else 4
+    _fused_two_aux_rms_norm_kernel[(num_tokens, 2)](
+        x0,
+        x1,
+        weight0,
+        weight1,
+        output,
+        x0.stride(0),
+        x1.stride(0),
+        output.stride(0),
+        hidden_size=hidden_size,
+        eps=eps,
+        block_size=block_size,
+        num_warps=num_warps,
+    )
+    return output
+
+
+def _fused_two_aux_rms_norm_fake(
+    x0: torch.Tensor,
+    x1: torch.Tensor,
+    weight0: torch.Tensor,
+    weight1: torch.Tensor,
+    eps: float,
+) -> torch.Tensor:
+    del x1, weight0, weight1, eps
+    return x0.new_empty(x0.shape[0], 2 * x0.shape[1])
+
+
+direct_register_custom_op(
+    op_name="fused_two_aux_rms_norm",
+    op_func=_fused_two_aux_rms_norm_impl,
+    mutates_args=[],
+    fake_impl=_fused_two_aux_rms_norm_fake,
+    dispatch_key=current_platform.dispatch_key,
+)
+
+
+def fused_two_aux_rms_norm(
+    x0: torch.Tensor,
+    x1: torch.Tensor,
+    weight0: torch.Tensor,
+    weight1: torch.Tensor,
+    eps: float,
+) -> torch.Tensor:
+    """RMS-normalize two EAGLE aux tensors into one concatenated output."""
+    if x0.ndim != 2 or x1.ndim != 2 or x0.shape != x1.shape:
+        raise ValueError("EAGLE aux tensors must be rank-2 and have equal shapes")
+    if x0.stride(1) != 1 or x1.stride(1) != 1:
+        raise ValueError(
+            "EAGLE aux tensors must be contiguous in the hidden dimension"
+        )
+    if weight0.shape != (x0.shape[1],) or weight1.shape != (x0.shape[1],):
+        raise ValueError("EAGLE aux RMSNorm weights must match the hidden size")
+    if x0.dtype != x1.dtype or x0.device != x1.device:
+        raise ValueError("EAGLE aux tensors must have the same dtype and device")
+    if weight0.device != x0.device or weight1.device != x0.device:
+        raise ValueError("EAGLE aux RMSNorm weights must be on the input device")
+    if weight0.dtype != x0.dtype or weight1.dtype != x0.dtype:
+        raise ValueError("EAGLE aux RMSNorm weights must match the input dtype")
+    if not weight0.is_contiguous() or not weight1.is_contiguous():
+        raise ValueError("EAGLE aux RMSNorm weights must be contiguous")
+    return torch.ops.vllm.fused_two_aux_rms_norm(
+        x0, x1, weight0, weight1, eps
+    )
