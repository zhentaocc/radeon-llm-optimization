+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import torch
+
+from vllm import _custom_ops as ops
+from vllm.model_executor.layers.eagle_aux_rmsnorm import fused_two_aux_rms_norm
+from vllm.model_executor.models.qwen3_eagle3 import Qwen3Eagle3DecoderLayer
+
+
+class _ReferenceRMSNorm:
+    def __init__(self, weight: torch.Tensor, eps: float) -> None:
+        self.weight = weight
+        self.variance_epsilon = eps
+
+    def __call__(self, x: torch.Tensor) -> torch.Tensor:
+        out = torch.empty_like(x)
+        ops.rms_norm(out, x, self.weight, self.variance_epsilon)
+        return out
+
+
+@torch.inference_mode()
+def test_qwen3_eagle_layer0_fused_input_prep() -> None:
+    torch.manual_seed(0)
+    num_tokens = 16
+    hidden_size = 5120
+    eps = 1e-6
+    embeds = torch.randn(
+        num_tokens, hidden_size, device="cuda", dtype=torch.bfloat16
+    )
+    hidden_states = torch.randn_like(embeds)
+    input_norm = _ReferenceRMSNorm(
+        torch.randn(hidden_size, device="cuda", dtype=torch.bfloat16), eps
+    )
+    hidden_norm = _ReferenceRMSNorm(
+        torch.randn(hidden_size, device="cuda", dtype=torch.bfloat16), eps
+    )
+    expected = torch.cat((input_norm(embeds), hidden_norm(hidden_states)), dim=-1)
+
+    layer = SimpleNamespace(
+        norm_before_residual=False,
+        input_layernorm=input_norm,
+        hidden_norm=hidden_norm,
+    )
+    actual, residual = Qwen3Eagle3DecoderLayer._prepare_first_layer_inputs(
+        layer, embeds, hidden_states
+    )
+
+    torch.testing.assert_close(actual, expected, atol=2e-2, rtol=2e-2)
+    assert residual is hidden_states
+
+
+@torch.inference_mode()
+def test_qwen3_eagle_layer0_falls_back_for_norm_before_residual() -> None:
+    torch.manual_seed(0)
+    embeds = torch.randn(4, 256, device="cuda", dtype=torch.bfloat16)
+    hidden_states = torch.randn_like(embeds)
+    eps = 1e-6
+    input_norm = _ReferenceRMSNorm(
+        torch.randn(256, device="cuda", dtype=torch.bfloat16), eps
+    )
+    hidden_norm = _ReferenceRMSNorm(
+        torch.randn(256, device="cuda", dtype=torch.bfloat16), eps
+    )
+
+    def norm_before(
+        hidden_states: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        normalized = hidden_norm(hidden_states)
+        return normalized, normalized
+
+    layer = SimpleNamespace(
+        norm_before_residual=True,
+        input_layernorm=input_norm,
+        hidden_norm=hidden_norm,
+        _residual_norm=norm_before,
+    )
+    actual, residual = Qwen3Eagle3DecoderLayer._prepare_first_layer_inputs(
+        layer, embeds, hidden_states
+    )
+    expected_hidden = hidden_norm(hidden_states)
+    expected = torch.cat((input_norm(embeds), expected_hidden), dim=-1)
+
+    torch.testing.assert_close(actual, expected)
+    torch.testing.assert_close(residual, expected_hidden)
+
+
+@torch.inference_mode()
+def test_fused_two_aux_rms_norm_torch_compile() -> None:
+    torch.manual_seed(0)
+    x0 = torch.randn(16, 5120, device="cuda", dtype=torch.bfloat16)
+    x1 = torch.randn_like(x0)
+    weight0 = torch.randn(5120, device="cuda", dtype=torch.bfloat16)
+    weight1 = torch.randn_like(weight0)
+    eps = 1e-6
+    expected = fused_two_aux_rms_norm(x0, x1, weight0, weight1, eps)
+
+    compiled = torch.compile(fused_two_aux_rms_norm, fullgraph=True)
+    actual = compiled(x0, x1, weight0, weight1, eps)
+
+    torch.testing.assert_close(actual, expected)
+
+
+@torch.inference_mode()
+def test_fused_two_aux_rms_norm_hip_graph_replay() -> None:
+    torch.manual_seed(0)
+    x0 = torch.randn(16, 5120, device="cuda", dtype=torch.bfloat16)
+    x1 = torch.randn_like(x0)
+    weight0 = torch.randn(5120, device="cuda", dtype=torch.bfloat16)
+    weight1 = torch.randn_like(weight0)
+    eps = 1e-6
+
+    static_x0 = x0.clone()
+    static_x1 = x1.clone()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        static_output = fused_two_aux_rms_norm(
+            static_x0, static_x1, weight0, weight1, eps
+        )
+
+    graph.replay()
+    expected = fused_two_aux_rms_norm(x0, x1, weight0, weight1, eps)
+    torch.testing.assert_close(static_output, expected)
+
+    static_x0.copy_(x0 * 0.5)
+    static_x1.copy_(x1 * 1.5)
+    graph.replay()
+    expected_replay = fused_two_aux_rms_norm(
+        static_x0, static_x1, weight0, weight1, eps
+    )
+    torch.testing.assert_close(static_output, expected_replay)
